{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-merge-pr.sh",
            "statusMessage": "Queuing auto-merge..."
          }
        ]
      }
    ]
  }
}
